{
    "name": "google-drive-cowork",
    "version": "2.0.0",
    "description": "Open Claude Cowork with integrated Google Drive MCP - Desktop AI assistant with native Google Drive, Docs, Sheets, and Slides support",
    "license": "MIT",
    "type": "module",
    "main": "main.js",
    "bin": {
        "google-drive-mcp": "./dist/index.js"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build:mcp": "npm run typecheck && node scripts/build.js",
        "start:mcp": "node dist/index.js",
        "auth": "node dist/index.js auth",
        "start:server": "node server/server.js",
        "start": "electron .",
        "dev": "NODE_ENV=development electron .",
        "setup": "bash setup.sh",
        "build": "npm run build:mcp",
        "watch": "node scripts/build.js --watch",
        "test": "echo \"No tests yet\" && exit 0"
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.2.7",
        "@composio/core": "latest",
        "@google-cloud/local-auth": "^3.0.1",
        "@modelcontextprotocol/sdk": "1.16.0",
        "@opencode-ai/sdk": "latest",
        "@types/express": "^5.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.1.0",
        "google-auth-library": "^9.15.0",
        "googleapis": "^144.0.0",
        "open": "^10.2.0",
        "punycode": "^2.3.1",
        "uuid": "^11.0.3",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/node": "^22.9.3",
        "@types/uuid": "^10.0.0",
        "electron": "^39.2.7",
        "electron-reload": "^2.0.0-alpha.1",
        "esbuild": "^0.25.8",
        "shx": "^0.3.4",
        "typescript": "^5.6.2"
    }
}
